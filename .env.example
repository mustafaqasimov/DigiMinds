# Demo identities and challenge controls are enabled ONLY in explicit demo mode.
DEMO_MODE=1
DATABASE_PATH=data/crisis.db
SECURE_COOKIES=0
# For production use DEMO_MODE=0 and supply a strong password (>=16 characters).
ADMIN_PASSWORD=
# Required in production: generate a random secret with at least 32 bytes.
# Demo mode generates a local, git-ignored <database>.jwt-key automatically.
JWT_SECRET=
SENSOR_KEY=
# Optional external provider. No key needed for local routing.
ORS_API_KEY=
ORS_URL=https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson
# Comma separated origins, required when accessing from a different host.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
